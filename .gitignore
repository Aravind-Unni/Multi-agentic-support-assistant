# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Secrets ---
.env
.env.*
!.env.example

# Note: data/ is intentionally tracked (not ignored). orders.json and
# trendly_policy.md are static source input the app needs to run, not
# generated build artifacts — RAG_setup.py builds the vector index in
# memory at every startup rather than persisting it to disk.

# --- MLflow / eval artifacts ---
mlruns/
mlflow.db

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log

# Note: uv.lock is intentionally NOT ignored — keep it committed so
# builds (including Docker) stay reproducible across machines.